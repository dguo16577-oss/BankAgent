# Frontend: copy these two public settings to apps/web/.env.local.
# Database settings below belong in the root .env / backend environment.
NEXT_PUBLIC_API_MODE=backend
NEXT_PUBLIC_BANKING_API_BASE_URL=http://localhost:18080
# Server-side Agent Runtime (local development).
ASTER_AGENT_RUNTIME_URL=http://127.0.0.1:8001
AGENT_UI_V2_ENABLED=false
COPILOTKIT_TELEMETRY_DISABLED=true
BANKING_API_BASE_URL=http://127.0.0.1:18080
DEEPSEEK_MODEL=deepseek-flash
# Set DEEPSEEK_API_KEY only in the Agent process environment; never commit it.
# Build/start require an explicit API origin; only dev/typegen supply a localhost default.
# HTTPS deployment only (leave unset for local HTTP): ASTER_HTTPS=true
# Explicit MSW development: pnpm dev:mock. Never used as backend fallback.

# PostgreSQL: local development only. Compose reads a root .env file.
POSTGRES_DB=aster_banking
POSTGRES_USER=aster_local
POSTGRES_PASSWORD=aster_local_dev_only
POSTGRES_PORT=5432
# Spring reads exported environment variables, not this file automatically.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aster_banking
SPRING_DATASOURCE_USERNAME=aster_local
SPRING_DATASOURCE_PASSWORD=aster_local_dev_only
