# Copy to .env.demo (ignored), replace CHANGE_ME, then pass --env-file .env.demo.
DB_NAME=asterbank
DB_USER=asterbank
DB_PASSWORD=CHANGE_ME
DEMO_PORT=8088
DEMO_BIND_ADDRESS=127.0.0.1
# For a separate prod deployment, also set DB_HOST and SPRING_PROFILES_ACTIVE=prod.
# DB_HOST=YOUR_DATABASE_HOST
# DB_PORT=5432
# PUBLIC_HOST=bank.example.com
# TLS_CERTIFICATE_PATH=/absolute/path/fullchain.pem
# TLS_PRIVATE_KEY_PATH=/absolute/path/privkey.pem
