# Local demo only. Copy to .env.start.local and change the password before first start.
DB_NAME=asterbank
DB_USER=asterbank
DB_PASSWORD=replace-with-a-long-local-demo-password
# Reasoning stays server-side; the UI receives execution status only.
DEEPSEEK_THINKING_ENABLED=1
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_THINKING_MAX_TOKENS=8192
